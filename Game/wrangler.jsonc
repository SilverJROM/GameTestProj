{
  // One Worker: static assets, one D1 database, and one Durable Object (WorldRoom).
  // database_id is the real D1 database created on the Cloudflare account (plan 05).
  "name": "game",
  // Public test URL on workers.dev; preview URLs are off so there is only one way in.
  "workers_dev": true,
  "preview_urls": false,
  "main": "src/server/index.ts",
  "compatibility_date": "2025-09-01",
  // Bundles the first-screen page and client script into src/client/shell.generated.ts.
  "build": {
    "command": "node scripts/build-client.mjs && node scripts/build-precompute.mjs",
  },
  "assets": {
    "directory": "./assets",
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "game-db",
      "database_id": "822ff1dd-f1e6-465b-bc9b-07a12da0d054",
      "migrations_dir": "migrations",
    },
  ],
  "durable_objects": {
    "bindings": [
      {
        "name": "WorldRoom",
        "class_name": "WorldRoom",
      },
    ],
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["WorldRoom"],
    },
  ],
}
